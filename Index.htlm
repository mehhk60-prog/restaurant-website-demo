html
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Moon Lovers Restaurant | قائمة الطعام</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap');
        body { font-family: 'Cairo', sans-serif; }
    </style>
</head>
<body class="bg-black text-white">

    <!-- Header -->
    <header class="py-10 text-center border-b border-yellow-600">
        <h1 class="text-5xl font-bold text-yellow-500">Moon Lovers</h1>
        <p class="text-xl text-gray-400 mt-2">مرحباً بكم في وجهتكم المميزة بجدة</p>
    </header>

    <!-- Menu Section -->
    <main class="max-w-4xl mx-auto py-12 px-6">
        <h2 class="text-3xl font-bold text-center mb-10 text-yellow-500">قائمة الطعام</h2>
        
        <div class="space-y-6">
            <!-- Item 1 -->
            <div class="flex justify-between items-center border-b border-gray-700 pb-4">
                <div>
                    <h3 class="text-xl font-bold">طبق القمر المميز</h3>
                    <p class="text-gray-400">نكهات شرقية بلمسة عصرية</p>
                </div>
                <span class="text-yellow-500 font-bold">85 ر.س</span>
            </div>
            
            <!-- Item 2 -->
            <div class="flex justify-between items-center border-b border-gray-700 pb-4">
                <div>
                    <h3 class="text-xl font-bold">قهوة Moon المختصة</h3>
                    <p class="text-gray-400">محضرة من أجود أنواع البن</p>
                </div>
                <span class="text-yellow-500 font-bold">25 ر.س</span>
            </div>

            <!-- Item 3 -->
            <div class="flex justify-between items-center border-b border-gray-700 pb-4">
                <div>
                    <h3 class="text-xl font-bold">حلويات السهرة</h3>
                    <p class="text-gray-400">تشكيلة حلى منزلية</p>
                </div>
                <span class="text-yellow-500 font-bold">40 ر.س</span>
            </div>
        </div>

        <!-- Action Button -->
        <div class="mt-12 text-center">
            <a href="https://wa.me/966557571798" class="bg-yellow-600 hover:bg-yellow-700 text-white px-10 py-4 rounded-full font-bold text-lg transition duration-300">
                اطلب الآن عبر واتساب
            </a>
        </div>
    </main>

    <!-- Footer -->
    <footer class="py-10 text-center border-t border-gray-800 text-gray-600">
        <p>تم التصميم بواسطة: أسامة - استشاري حلول رقمية</p>
    </footer>

</body>
</html>
